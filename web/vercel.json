{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{**/experiments/**,**/data/**,**/models/**,**/results/**,**/node_modules/**,**/src/**,**/public/**,**/scripts/**,**/dist/**,**/.venv/**,**/.vercel/**,**/__pycache__/**,**/tests/**,**/test/**,**/docs/**,**/benchmarks/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
