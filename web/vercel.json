{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,**/node_modules/**,src/**,public/**,scripts/**,dist/**,.venv/**,**/.venv/**,venv/**,**/venv/**,.git/**,.vercel/**,**/__pycache__/**,**/*.pyc,**/tests/**,**/test/**,**/benchmarks/**,**/docs/**,README.md,index.html,vite.config.js,package.json,package-lock.json,artifacts/validation_regression_metrics.csv}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
