{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,src/**,public/**,scripts/**,dist/**,**/.venv/**,**/venv/**,.git/**,.vercel/**,**/__pycache__/**,**/*.pyc,**/tests/**,**/test/**,**/benchmarks/**,**/docs/**,*.md,*.html,*.js,package*.json,artifacts/validation*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
